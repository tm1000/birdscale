# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# ---- Tailscale -------------------------------------------------------------
# Auth key (tskey-auth-...). Empty = interactive login (the URL is logged and shown
# on the status page). Use a reusable, pre-approved, tagged key if the tailnet has
# device approval. It is only used at first registration (or if the tailscale state
# volume is lost): tagged nodes have key expiry disabled. Auth keys last at most 90 days.
# For redeploys that need no re-keying, use an OAuth client secret instead (it does not
# expire; create it under Settings > OAuth clients with scope auth_keys (write) and
# tag:birdscale). TS_TAGS is then required:
#   TS_AUTHKEY=tskey-client-XXXX?ephemeral=false&preauthorized=true
TS_AUTHKEY=
# Hostname in the tailnet.
TS_HOSTNAME=birdscale
# Comma list of tags to advertise (needs tagOwners in the policy). Empty = join as your user.
TS_TAGS=tag:birdscale
# Headscale / custom control server. Empty = Tailscale SaaS.
TS_LOGIN_SERVER=
# tailscaled UDP port (container side).
TS_PORT=41641
# off | nodivert | on. Keep "off": tailscaled's own rules drop forwarded
# traffic from 100.64.0.0/10 and birdscale owns the firewall.
TS_NETFILTER_MODE=off

# ---- NetBird ---------------------------------------------------------------
# Required. Cloud: https://api.netbird.io:443 ; self-hosted: your own URL.
NB_MANAGEMENT_URL=https://api.netbird.io:443
# Setup key. Empty = SSO login (the device-flow URL is logged and shown on the status page).
NB_SETUP_KEY=
# Peer name shown in NetBird (default: container hostname).
NB_HOSTNAME=
# NetBird WireGuard UDP port (container side).
NB_PORT=51820

# ---- birdscale -------------------------------------------------------------
# Comma list of routes to advertise. Replaces the list computed from NetBird.
BS_ROUTES=
# Also advertise 0.0.0.0/0 and ::/0 (exit node). Default false.
BS_ADVERTISE_EXIT_NODE=false
# Status page on the bridge's Tailscale IP(s). Unset = disabled. Read-only except
# one button: NetBird re-login (WhoIs allow-list + CSRF token). The Prometheus
# endpoint (/metrics) is served on the same listener, so it also needs this set.
BS_WEBUI_PORT=
# Who may view the page and scrape /metrics: comma list of user logins and/or
# tag:xxx, e.g. "admin@example.internal,tag:prometheus". Empty = any tailnet caller.
BS_WEBUI_ALLOW=
# Loopback port for /healthz and the Docker HEALTHCHECK.
BS_HEALTH_PORT=9180
# debug | info | warn | error
BS_LOG_LEVEL=info

# ---- DNS forwarder and domain resources -------------------------------------
# NetBird "domain resources" only resolve through NetBird's DNS. The forwarder
# listens on UDP+TCP port 53 on the bridge's Tailscale IP(s) only and forwards to
# NetBird's resolver. Point a Tailscale split-DNS entry at the bridge (see README).
BS_DNS=true
# Comma list of domain suffixes to forward, e.g. example.internal,corp.test.
# Anything else gets REFUSED. Empty = forward everything.
BS_DNS_DOMAINS=
# After an answer for a domain resource, wait up to this long for its /32 to be
# advertised to the tailnet before replying (Go duration; 0 = do not wait).
BS_DNS_ROUTE_WAIT=1500ms
# Re-resolve every non-wildcard domain resource this often so its /32 is already
# advertised before the first client asks (0 = only at start and when the list changes).
BS_DOMAIN_REFRESH=5m
# Warn (log + status page banner) when the NetBird SSO session expires within
# this long. NetBird SSO sessions last 7 days by default. 0 = never warn.
BS_SESSION_WARN=24h

# ---- Docker image (compose only) --------------------------------------------
# Default: the published image. For a local build use
#   BIRDSCALE_IMAGE=birdscale:local docker compose build
#BIRDSCALE_IMAGE=ghcr.io/tm1000/birdscale:latest
# Version stamped into a local build (shown in logs, status page, metrics).
#BIRDSCALE_VERSION=dev

# ---- Docker host ports (compose only) --------------------------------------
# Host-side UDP ports. Change TS_HOST_PORT if the host already runs tailscaled.
TS_HOST_PORT=41641
NB_HOST_PORT=51820
